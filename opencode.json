{
  "$schema": "https://opencode.ai/config.json",
  "instructions": ["docs/laya-decisions.md"],
  "experimental": {
    "mcp_timeout": 120000
  },
  "mcp": {
    "laya": {
      "type": "local",
      "command": ["python", "-m", "laya.mcp.server"],
      "enabled": true,
      "environment": {
        "LAYA_DEVICE": "cpu",
        "LAYA_PRELOAD": "0"
      }
    }
  }
}
